name: HMAX Python Syntax

on:
  push:
    branches: ["main"]
  pull_request:

jobs:
  syntax:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"
      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt || true
          pip install pyTelegramBotAPI telebot
      - name: Compile all Python files
        # Compile every tracked module, not a hand-maintained list: the old
        # hard-coded list silently skipped hmax_dump_tools.py and let a syntax
        # error ship, which killed the DUMP tools section at import time.
        run: git ls-files -z '*.py' | xargs -0 --no-run-if-empty python -m py_compile
      - name: Run runtime helper tests
        run: python -m unittest discover -s tests -v
